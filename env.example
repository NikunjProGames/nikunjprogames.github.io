@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;600;700&family=Rajdhani:wght@400;500;600;700&display=swap');
:root{--bg:#050816;--panel:#0b1125;--panel2:#101a35;--text:#edf4ff;--muted:#8f9db8;--line:rgba(255,255,255,.09);--accent:#28b9ff;--danger:#ff5e75;--ok:#45e0a2}
*{box-sizing:border-box}::selection{background:#ff4fd8;color:#fff}
body{margin:0;background:radial-gradient(circle at 20% 0%,rgba(123,92,255,.14),transparent 30%),var(--bg);color:var(--text);font-family:Rajdhani,sans-serif}
button,input{font:inherit}button{cursor:pointer}
.hidden{display:none!important}.center{min-height:100vh;display:grid;place-items:center;padding:20px}
.auth-card{width:min(440px,100%);background:rgba(11,17,37,.92);border:1px solid var(--line);border-radius:24px;padding:34px;box-shadow:0 25px 80px rgba(0,0,0,.35)}
.brand{font:700 1.25rem Orbitron;display:flex;align-items:center;gap:6px}.brand-mark{display:grid;place-items:center;width:30px;height:30px;border:1px solid var(--accent);border-radius:9px;color:var(--accent)}.brand small{color:var(--muted);font:600 .65rem Rajdhani;letter-spacing:.14em}
.auth-card h1,.welcome h1{font:700 2rem Orbitron}.auth-card p{color:var(--muted)}
label{display:block;color:#b7c4da;margin:16px 0 7px}input{width:100%;background:#070d1e;color:#fff;border:1px solid var(--line);border-radius:12px;padding:13px;outline:none}input:focus{border-color:var(--accent)}
button{border:0;border-radius:12px;padding:12px 17px;background:var(--accent);color:#00111a;font-weight:700}form button{width:100%;margin-top:12px}.error{color:var(--danger)!important;min-height:20px}
.admin-header{height:70px;padding:0 5vw;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;background:rgba(5,8,22,.85);backdrop-filter:blur(15px);position:sticky;top:0;z-index:10}.header-actions{display:flex;gap:12px;align-items:center;color:var(--muted)}
.ghost{background:transparent;border:1px solid var(--line);color:#d9e5f7}.dashboard{width:min(1150px,90%);margin:auto}.welcome{display:flex;justify-content:space-between;align-items:end;padding:60px 0 35px}.welcome p{color:var(--muted);margin:6px 0}.eyebrow{font:700 .7rem Orbitron;letter-spacing:.16em;color:var(--accent)}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.stats div{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:20px}.stats strong{display:block;font:700 2rem Orbitron}.stats span{color:var(--muted)}
.toolbar{display:flex;justify-content:space-between;align-items:center;margin:45px 0 16px}.toolbar h2{font:600 1.5rem Orbitron}.article-list{display:grid;gap:15px;padding-bottom:80px}
.article-item{background:var(--panel);border:1px solid var(--line);border-radius:19px;padding:22px}.article-top{display:flex;justify-content:space-between;gap:15px}.article-item h3{font:600 1.2rem Orbitron;margin:4px 0 9px}.article-item p{color:var(--muted);line-height:1.45}.badge{display:inline-block;padding:5px 9px;border-radius:999px;background:rgba(40,185,255,.1);color:var(--accent);font-size:.78rem}.sources{font-size:.9rem}.sources a{color:var(--accent);display:block;margin-top:5px}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:17px}.approve{background:var(--ok);color:#00150d}.reject{background:transparent;border:1px solid rgba(255,94,117,.4);color:#ff8193}.status{color:var(--muted);min-height:24px}
@media(max-width:650px){.welcome{display:block}.welcome button{margin-top:20px}.stats{grid-template-columns:1fr}.admin-header{height:auto;padding:15px 5vw;gap:12px;align-items:flex-start}.header-actions{flex-wrap:wrap;justify-content:flex-end}.article-top{display:block}}

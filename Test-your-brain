<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>PleyZ Brain Test</title>

    <meta
        name="description"
        content="Think you're smart? Survive 25 tricky brain challenges in the PleyZ Original Brain Test."
    >

    <meta name="theme-color" content="#fffaf0">

    <style>
        /* =====================================================
           PLEYZ BRAIN TEST
           SINGLE-FILE VERSION
           ===================================================== */

        :root {
            --cream: #fffaf0;
            --paper: #ffffff;

            --green: #38a169;
            --green-dark: #27784d;
            --green-light: #e0f5e7;

            --yellow: #ffd84d;
            --yellow-light: #fff3b8;

            --orange: #ff9f43;
            --orange-light: #fff0dc;

            --red: #ef6b62;
            --red-light: #ffe3e0;

            --blue: #65a9e8;
            --blue-light: #e7f3ff;

            --ink: #24312b;
            --muted: #718078;

            --border: #e9e7dc;

            --shadow:
                0 18px 45px rgba(36, 49, 43, 0.10);

            --soft-shadow:
                0 8px 22px rgba(36, 49, 43, 0.08);
        }


        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }


        html {
            min-height: 100%;
        }


        body {
            min-height: 100vh;

            background:
                radial-gradient(
                    circle at 12% 12%,
                    rgba(255, 216, 77, 0.24),
                    transparent 28%
                ),
                radial-gradient(
                    circle at 88% 82%,
                    rgba(56, 161, 105, 0.15),
                    transparent 30%
                ),
                var(--cream);

            color: var(--ink);

            font-family:
                Inter,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;

            overflow-x: hidden;
        }


        button {
            font: inherit;
        }


        button:focus-visible {
            outline: 3px solid rgba(56, 161, 105, 0.35);
            outline-offset: 3px;
        }


        .game-shell {
            width: 100%;
            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 25px;
        }


        .screen {
            width: min(760px, 100%);

            display: none;

            animation: screenIn 0.45s ease;
        }


        .screen.active {
            display: block;
        }


        @keyframes screenIn {
            from {
                opacity: 0;
                transform: translateY(15px) scale(0.98);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }


        /* =====================================================
           START SCREEN
           ===================================================== */

        .start-card {
            background: rgba(255, 255, 255, 0.90);

            border: 1px solid rgba(255, 255, 255, 0.9);

            border-radius: 32px;

            padding: 46px 42px;

            text-align: center;

            box-shadow: var(--shadow);

            backdrop-filter: blur(12px);
        }


        .mascot-wrap {
            position: relative;

            width: 130px;
            height: 130px;

            margin: 0 auto 20px;
        }


        .mascot {
            width: 130px;
            height: 130px;

            display: grid;
            place-items: center;

            background: var(--yellow);

            border-radius: 42% 58% 55% 45%;

            font-size: 68px;

            box-shadow:
                0 12px 0 #e7bd35,
                0 22px 35px rgba(36, 49, 43, 0.12);

            animation: mascotFloat 3s ease-in-out infinite;
        }


        @keyframes mascotFloat {
            0%,
            100% {
                transform: rotate(-3deg) translateY(0);
            }

            50% {
                transform: rotate(3deg) translateY(-8px);
            }
        }


        .mascot-spark {
            position: absolute;

            font-size: 22px;

            color: var(--orange);

            animation: sparkle 2s ease-in-out infinite;
        }


        .spark-one {
            top: 5px;
            right: 0;
        }


        .spark-two {
            bottom: 8px;
            left: -3px;

            animation-delay: 0.5s;
        }


        .spark-three {
            top: 48%;
            right: -17px;

            animation-delay: 1s;
        }


        @keyframes sparkle {
            0%,
            100% {
                opacity: 0.35;
                transform: scale(0.8);
            }

            50% {
                opacity: 1;
                transform: scale(1.2);
            }
        }


        .eyebrow {
            display: inline-flex;

            padding: 7px 13px;

            border-radius: 999px;

            background: var(--green-light);

            color: var(--green-dark);

            font-size: 12px;
            font-weight: 900;

            letter-spacing: 0.08em;
            text-transform: uppercase;
        }


        .start-card h1,
        .result-card h1 {
            margin-top: 16px;

            font-size: clamp(34px, 7vw, 56px);

            line-height: 1;

            letter-spacing: -0.045em;
        }


        .start-description {
            max-width: 470px;

            margin: 18px auto 28px;

            color: var(--muted);

            font-size: 17px;

            line-height: 1.6;
        }


        /* =====================================================
           BUTTONS
           ===================================================== */

        .primary-button,
        .secondary-button {
            border: 0;

            min-height: 54px;

            padding: 0 25px;

            border-radius: 17px;

            cursor: pointer;

            font-weight: 900;

            transition:
                transform 0.18s ease,
                box-shadow 0.18s ease,
                background 0.18s ease;
        }


        .primary-button {
            background: var(--green);

            color: white;

            box-shadow:
                0 6px 0 var(--green-dark),
                0 12px 24px rgba(56, 161, 105, 0.22);
        }


        .primary-button span {
            margin-left: 8px;
        }


        .primary-button:hover {
            transform: translateY(-2px);

            box-shadow:
                0 8px 0 var(--green-dark),
                0 15px 28px rgba(56, 161, 105, 0.25);
        }


        .primary-button:active {
            transform: translateY(4px);

            box-shadow:
                0 2px 0 var(--green-dark),
                0 6px 12px rgba(56, 161, 105, 0.18);
        }


        .secondary-button {
            background: var(--paper);

            color: var(--ink);

            border: 2px solid var(--border);

            box-shadow: var(--soft-shadow);
        }


        .secondary-button:hover {
            transform: translateY(-2px);

            background: #fffdf8;
        }


        .game-info {
            display: flex;

            flex-wrap: wrap;

            justify-content: center;

            gap: 9px;

            margin-top: 28px;
        }


        .game-info span {
            padding: 8px 11px;

            border-radius: 999px;

            background: #f7f6ef;

            color: var(--muted);

            font-size: 12px;

            font-weight: 700;
        }


        /* =====================================================
           GAME HEADER
           ===================================================== */

        .game-header {
            margin-bottom: 15px;
        }


        .progress-info {
            display: flex;

            justify-content: space-between;

            margin-bottom: 9px;

            color: var(--muted);

            font-size: 13px;

            font-weight: 800;
        }


        .progress-track {
            width: 100%;
            height: 10px;

            overflow: hidden;

            border-radius: 999px;

            background: #e9e8de;
        }


        .progress-bar {
            width: 0;
            height: 100%;

            border-radius: inherit;

            background:
                linear-gradient(
                    90deg,
                    var(--green),
                    #7bcf8f
                );

            transition: width 0.45s ease;
        }


        /* =====================================================
           CHALLENGE CARD
           ===================================================== */

        .challenge-card {
            position: relative;

            background: rgba(255, 255, 255, 0.93);

            border: 1px solid rgba(255, 255, 255, 0.9);

            border-radius: 30px;

            padding: 31px;

            box-shadow: var(--shadow);
        }


        .challenge-top {
            display: flex;

            justify-content: space-between;

            align-items: center;

            min-height: 28px;
        }


        .challenge-type {
            display: inline-flex;

            padding: 6px 10px;

            border-radius: 9px;

            background: var(--yellow-light);

            color: #806200;

            font-size: 11px;

            font-weight: 900;

            letter-spacing: 0.08em;
        }


        .streak-display {
            color: var(--green);

            font-size: 13px;

            font-weight: 900;
        }


        .challenge-card h2 {
            margin-top: 22px;

            font-size: clamp(25px, 5vw, 38px);

            line-height: 1.12;

            letter-spacing: -0.035em;
        }


        .instruction {
            min-height: 25px;

            margin-top: 9px;

            color: var(--muted);

            font-size: 14px;
        }


        .challenge-area {
            margin-top: 25px;
        }


        /* =====================================================
           MULTIPLE CHOICE
           ===================================================== */

        .answer-grid {
            display: grid;

            grid-template-columns: repeat(2, 1fr);

            gap: 12px;
        }


        .answer-button {
            min-height: 62px;

            padding: 15px;

            border: 2px solid var(--border);

            border-radius: 17px;

            background: #fff;

            color: var(--ink);

            cursor: pointer;

            text-align: left;

            font-weight: 800;

            transition:
                transform 0.15s ease,
                border-color 0.15s ease,
                background 0.15s ease;
        }


        .answer-button:hover {
            transform: translateY(-2px);

            border-color: #c9d9ce;

            background: #fcfffb;
        }


        .answer-button.correct {
            border-color: var(--green);

            background: var(--green-light);

            animation: correctPop 0.4s ease;
        }


        .answer-button.wrong {
            border-color: var(--red);

            background: var(--red-light);

            animation: wrongShake 0.4s ease;
        }


        .answer-button:disabled {
            cursor: default;
        }


        @keyframes correctPop {
            50% {
                transform: scale(1.04);
            }
        }


        @keyframes wrongShake {
            20% {
                transform: translateX(-7px);
            }

            40% {
                transform: translateX(7px);
            }

            60% {
                transform: translateX(-5px);
            }

            80% {
                transform: translateX(5px);
            }
        }


        /* =====================================================
           ORDER / SORTING
           ===================================================== */

        .sort-list {
            display: flex;

            flex-direction: column;

            gap: 10px;
        }


        .sort-item {
            min-height: 57px;

            display: flex;

            align-items: center;

            justify-content: space-between;

            padding: 13px 17px;

            border: 2px solid var(--border);

            border-radius: 16px;

            background: #fff;

            cursor: pointer;

            font-weight: 800;

            user-select: none;

            -webkit-tap-highlight-color: transparent;

            transition:
                transform 0.15s ease,
                border-color 0.15s ease,
                background 0.15s ease;
        }


        .sort-item:hover {
            transform: translateX(3px);
        }


        .sort-item.selected {
            border-color: var(--green);

            background: var(--green-light);

            transform: translateX(6px);
        }


        .sort-number {
            width: 28px;
            height: 28px;

            display: grid;
            place-items: center;

            margin-left: 10px;

            border-radius: 50%;

            background: var(--yellow);

            font-size: 13px;

            flex-shrink: 0;
        }


        /* =====================================================
           INTERACTION CHALLENGE
           ===================================================== */

        .interaction-box {
            display: flex;

            flex-direction: column;

            gap: 14px;
        }


        .interaction-object {
            min-height: 120px;

            display: grid;

            place-items: center;

            padding: 20px;

            border-radius: 23px;

            background: #f8f7ef;

            border: 2px dashed #d9d7ca;

            cursor: pointer;

            user-select: none;

            transition:
                transform 0.18s ease,
                background 0.18s ease,
                border-color 0.18s ease;
        }


        .interaction-object:hover {
            transform: scale(1.02);

            border-color: var(--green);
        }


        .interaction-object.active {
            background: var(--green-light);

            border-color: var(--green);

            animation: objectBounce 0.4s ease;
        }


        .big-emoji {
            font-size: 54px;
        }


        .interaction-buttons {
            display: grid;

            grid-template-columns: repeat(2, 1fr);

            gap: 10px;
        }


        .mini-button {
            min-height: 54px;

            border: 2px solid var(--border);

            border-radius: 15px;

            background: white;

            cursor: pointer;

            color: var(--ink);

            font-weight: 800;

            transition: 0.16s ease;
        }


        .mini-button:hover {
            transform: translateY(-2px);

            border-color: var(--green);
        }


        .mini-button.selected {
            background: var(--green-light);

            border-color: var(--green);
        }


        @keyframes objectBounce {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.06) rotate(1deg);
            }

            100% {
                transform: scale(1);
            }
        }


        /* =====================================================
           REACTION
           ===================================================== */

        .reaction-box {
            display: none;

            align-items: center;

            gap: 13px;

            margin-top: 22px;

            padding: 14px 16px;

            border-radius: 18px;

            background: #f7f7f1;

            border: 1px solid var(--border);

            animation: reactionIn 0.35s ease;
        }


        .reaction-box.show {
            display: flex;
        }


        .reaction-emoji {
            width: 48px;
            height: 48px;

            display: grid;
            place-items: center;

            flex-shrink: 0;

            border-radius: 15px;

            background: var(--yellow);

            font-size: 25px;
        }


        .reaction-box strong {
            font-size: 15px;
        }


        .reaction-box p {
            margin-top: 3px;

            color: var(--muted);

            font-size: 13px;

            line-height: 1.5;
        }


        @keyframes reactionIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }


        .next-button {
            width: 100%;

            margin-top: 15px;
        }


        .hidden {
            display: none !important;
        }


        /* =====================================================
           RESULT
           ===================================================== */

        .result-mascot {
            width: 110px;
            height: 110px;

            display: grid;
            place-items: center;

            margin: 0 auto 18px;

            border-radius: 40% 60% 55% 45%;

            background: var(--yellow);

            font-size: 58px;

            box-shadow:
                0 10px 0 #e7bd35,
                0 20px 35px rgba(36, 49, 43, 0.10);

            animation: mascotFloat 3s ease-in-out infinite;
        }


        .result-card {
            padding: 38px 30px;

            border-radius: 30px;

            background: rgba(255, 255, 255, 0.92);

            text-align: center;

            box-shadow: var(--shadow);
        }


        .score-circle {
            width: 145px;
            height: 145px;

            display: flex;

            align-items: center;
            justify-content: center;

            margin: 28px auto 18px;

            border-radius: 50%;

            background:
                conic-gradient(
                    var(--green) 0deg,
                    var(--green-light) 0deg
                );

            position: relative;

            transition: background 0.8s ease;
        }


        .score-circle::after {
            content: "";

            position: absolute;

            inset: 10px;

            border-radius: 50%;

            background: white;
        }


        .score-circle span,
        .score-circle small {
            position: relative;

            z-index: 1;
        }


        .score-circle span {
            font-size: 48px;

            font-weight: 950;

            letter-spacing: -0.06em;
        }


        .score-circle small {
            align-self: flex-end;

            margin-bottom: 38px;

            color: var(--muted);

            font-size: 16px;

            font-weight: 800;
        }


        .result-message {
            max-width: 450px;

            margin: 0 auto;

            color: var(--muted);

            line-height: 1.5;
        }


        .stats {
            display: grid;

            grid-template-columns: repeat(3, 1fr);

            gap: 10px;

            margin: 27px 0;
        }


        .stat {
            padding: 15px 8px;

            border-radius: 16px;

            background: #f7f6ef;
        }


        .stat strong {
            display: block;

            font-size: 23px;
        }


        .stat span {
            color: var(--muted);

            font-size: 11px;

            font-weight: 800;

            text-transform: uppercase;
        }


        .result-actions {
            display: flex;

            flex-direction: column;

            gap: 10px;
        }


        .result-actions button {
            width: 100%;
        }


        /* =====================================================
           TOAST
           ===================================================== */

        .toast {
            position: fixed;

            left: 50%;
            bottom: 25px;

            transform: translate(-50%, 100px);

            padding: 12px 18px;

            border-radius: 999px;

            background: var(--ink);

            color: white;

            font-size: 13px;

            font-weight: 800;

            box-shadow: var(--shadow);

            opacity: 0;

            pointer-events: none;

            transition:
                opacity 0.25s ease,
                transform 0.25s ease;

            z-index: 100;
        }


        .toast.show {
            opacity: 1;

            transform: translate(-50%, 0);
        }


        /* =====================================================
           CONFETTI
           ===================================================== */

        .confetti {
            position: fixed;

            width: 9px;
            height: 15px;

            top: -20px;

            pointer-events: none;

            z-index: 200;

            animation:
                confettiFall 1.7s linear forwards;
        }


        @keyframes confettiFall {
            from {
                transform:
                    translateY(0)
                    rotate(0deg);
                opacity: 1;
            }

            to {
                transform:
                    translateY(110vh)
                    rotate(720deg);
                opacity: 0;
            }
        }


        /* =====================================================
           MOBILE
           ===================================================== */

        @media (max-width: 600px) {

            .game-shell {
                padding: 14px;
            }


            .start-card {
                padding: 35px 20px;
            }


            .challenge-card {
                padding: 22px 17px;

                border-radius: 24px;
            }


            .answer-grid {
                grid-template-columns: 1fr;
            }


            .start-card h1,
            .result-card h1 {
                font-size: 35px;
            }


            .challenge-card h2 {
                font-size: 27px;
            }


            .game-info {
                gap: 6px;
            }


            .game-info span {
                font-size: 11px;
            }


            .stats {
                gap: 7px;
            }


            .stat {
                padding: 13px 5px;
            }


            .interaction-buttons {
                grid-template-columns: 1fr;
            }

        }


        @media (max-width: 390px) {

            .start-card {
                padding: 28px 16px;
            }


            .challenge-card {
                padding: 19px 14px;
            }


            .mascot-wrap,
            .mascot {
                width: 112px;
                height: 112px;
            }


            .mascot {
                font-size: 58px;
            }


            .score-circle {
                width: 130px;
                height: 130px;
            }

        }


        @media (prefers-reduced-motion: reduce) {

            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }

        }

    </style>
</head>


<body>

    <main class="game-shell">

        <!-- =================================================
             START
             ================================================= -->

        <section id="startScreen" class="screen active">

            <div class="mascot-wrap">

                <div class="mascot">
                    🧠
                </div>

                <div class="mascot-spark spark-one">
                    ✦
                </div>

                <div class="mascot-spark spark-two">
                    ✦
                </div>

                <div class="mascot-spark spark-three">
                    •
                </div>

            </div>


            <div class="start-card">

                <div class="eyebrow">
                    PleyZ Original
                </div>


                <h1>
                    Think you're smart?
                </h1>


                <p class="start-description">
                    Let's find out.
                    Some questions are normal.
                    Some absolutely aren't. 😈
                </p>


                <button
                    id="playButton"
                    class="primary-button"
                    type="button"
                >
                    PLAY
                    <span>→</span>
                </button>


                <div class="game-info">

                    <span>
                        🧠 5 Levels
                    </span>

                    <span>
                        ⚡ 25 Challenges
                    </span>

                    <span>
                        🎯 No studying required
                    </span>

                </div>

            </div>

        </section>


        <!-- =================================================
             GAME
             ================================================= -->

        <section id="gameScreen" class="screen">

            <header class="game-header">

                <div class="progress-info">

                    <span id="challengeNumber">
                        Challenge 1 / 25
                    </span>

                    <span id="scoreDisplay">
                        Score: 0
                    </span>

                </div>


                <div class="progress-track">

                    <div
                        id="progressBar"
                        class="progress-bar"
                    ></div>

                </div>

            </header>


            <div
                id="challengeCard"
                class="challenge-card"
            >

                <div class="challenge-top">

                    <div
                        id="challengeType"
                        class="challenge-type"
                    >
                        QUESTION
                    </div>


                    <div
                        id="streakDisplay"
                        class="streak-display"
                    ></div>

                </div>


                <h2 id="questionText">
                    Loading...
                </h2>


                <p
                    id="instructionText"
                    class="instruction"
                ></p>


                <div
                    id="challengeArea"
                    class="challenge-area"
                ></div>


                <div
                    id="reactionBox"
                    class="reaction-box"
                >

                    <div
                        id="reactionEmoji"
                        class="reaction-emoji"
                    >
                        🧠
                    </div>


                    <div>

                        <strong id="reactionTitle">
                            Ready?
                        </strong>

                        <p id="reactionText"></p>

                    </div>

                </div>


                <button
                    id="nextButton"
                    class="primary-button next-button hidden"
                    type="button"
                >
                    NEXT
                    <span>→</span>
                </button>

            </div>

        </section>


        <!-- =================================================
             RESULT
             ================================================= -->

        <section id="resultScreen" class="screen">

            <div
                id="resultMascot"
                class="result-mascot"
            >
                🧠
            </div>


            <div class="result-card">

                <div class="eyebrow">
                    You survived
                </div>


                <h1 id="resultTitle">
                    Suspiciously Smart 😳
                </h1>


                <div
                    id="scoreCircle"
                    class="score-circle"
                >

                    <span id="finalScore">
                        0
                    </span>

                    <small>
                        / 25
                    </small>

                </div>


                <p
                    id="resultMessage"
                    class="result-message"
                >
                    Somehow, you made it.
                </p>


                <div class="stats">

                    <div class="stat">

                        <strong id="correctStat">
                            0
                        </strong>

                        <span>
                            Correct
                        </span>

                    </div>


                    <div class="stat">

                        <strong id="wrongStat">
                            0
                        </strong>

                        <span>
                            Wrong
                        </span>

                    </div>


                    <div class="stat">

                        <strong id="accuracyStat">
                            0%
                        </strong>

                        <span>
                            Accuracy
                        </span>

                    </div>

                </div>


                <div class="result-actions">

                    <button
                        id="shareButton"
                        class="primary-button"
                        type="button"

        function showScreen(screen) {

            document
                .querySelectorAll(".screen")
                .forEach((element) => {

                    element.classList.remove("active");

                });


            screen.classList.add("active");

        }


        /* =====================================================
           START GAME
           ===================================================== */

        function startGame() {

            currentChallenge = 0;

            score = 0;

            correctAnswers = 0;

            wrongAnswers = 0;

            streak = 0;

            answered = false;


            showScreen(gameScreen);

            loadChallenge();

        }


        /* =====================================================
           LOAD CHALLENGE
           ===================================================== */

        function loadChallenge() {

            answered = false;


            const challenge =
                challenges[currentChallenge];


            challengeNumber.textContent =
                `Challenge ${currentChallenge + 1} / ${TOTAL_CHALLENGES}`;


            scoreDisplay.textContent =
                `Score: ${score}`;


            progressBar.style.width =
                `${((currentChallenge) / TOTAL_CHALLENGES) * 100}%`;


            challengeType.textContent =
                challenge.type;


            questionText.textContent =
                challenge.question;


            instructionText.textContent =
                challenge.instruction || "";


            challengeArea.innerHTML = "";


            reactionBox.classList.remove("show");


            nextButton.classList.add("hidden");


            updateStreak();


            if (challenge.type === "QUESTION") {

                renderQuestion(challenge);

            }

            else if (challenge.type === "SORT") {

                renderSort(challenge);

            }

        }


        /* =====================================================
           QUESTION
           ===================================================== */

        function renderQuestion(challenge) {

            const grid =
                document.createElement("div");


            grid.className =
                "answer-grid";


            challenge.options.forEach(
                (option, index) => {

                    const button =
                        document.createElement("button");


                    button.type = "button";

                    button.className =
                        "answer-button";


                    button.textContent =
                        option;


                    button.addEventListener(
                        "click",
                        () => {

                            handleAnswer(
                                index === challenge.answer,
                                button,
                                challenge
                            );

                        }
                    );


                    grid.appendChild(button);

                }
            );


            challengeArea.appendChild(grid);

        }


        /* =====================================================
           SORTING
           ===================================================== */

        function renderSort(challenge) {

            const list =
                document.createElement("div");


            list.className =
                "sort-list";


            const shuffled =
                [...challenge.items]
                .sort(() => Math.random() - 0.5);


            let selectedOrder = [];


            shuffled.forEach((item) => {

                const element =
                    document.createElement("button");


                element.type = "button";

                element.className =
                    "sort-item";


                element.innerHTML = `
                    <span>${item}</span>
                    <span class="sort-number"></span>
                `;


                element.addEventListener(
                    "click",
                    () => {

                        if (answered) {
                            return;
                        }


                        if (
                            selectedOrder.includes(item)
                        ) {

                            selectedOrder =
                                selectedOrder.filter(
                                    (value) =>
                                        value !== item
                                );


                            element.classList.remove(
                                "selected"
                            );


                            element.querySelector(
                                ".sort-number"
                            ).textContent = "";


                            /*
                             * Re-number all selected items.
                             */

                            document
                                .querySelectorAll(
                                    ".sort-item"
                                )
                                .forEach((button) => {

                                    const value =
                                        button
                                            .querySelector(
                                                "span"
                                            )
                                            .textContent;


                                    const position =
                                        selectedOrder.indexOf(
                                            value
                                        );


                                    button.querySelector(
                                        ".sort-number"
                                    ).textContent =
                                        position >= 0
                                            ? position + 1
                                            : "";

                                });

                        }

                        else {

                            selectedOrder.push(item);


                            element.classList.add(
                                "selected"
                            );


                            element.querySelector(
                                ".sort-number"
                            ).textContent =
                                selectedOrder.length;

                        }


                        if (
                            selectedOrder.length ===
                            challenge.answer.length
                        ) {

                            const isCorrect =
                                selectedOrder.every(
                                    (value, index) =>
                                        value ===
                                        challenge.answer[index]
                                );


                            handleAnswer(
                                isCorrect,
                                null,
                                challenge
                            );

                        }

                    }
                );


                list.appendChild(element);

            });


            challengeArea.appendChild(list);

        }


        /* =====================================================
           ANSWER HANDLER
           ===================================================== */

        function handleAnswer(
            isCorrect,
            selectedButton,
            challenge
        ) {

            if (answered) {
                return;
            }


            answered = true;


            if (isCorrect) {

                score++;

                correctAnswers++;

                streak++;

            }

            else {

                wrongAnswers++;

                streak = 0;

            }


            if (selectedButton) {

                selectedButton.classList.add(
                    isCorrect
                        ? "correct"
                        : "wrong"
                );

            }


            document
                .querySelectorAll(
                    ".answer-button"
                )
                .forEach((button) => {

                    button.disabled = true;

                });


            scoreDisplay.textContent =
                `Score: ${score}`;


            updateStreak();


            showReaction(
                isCorrect,
                challenge.explanation
            );


            nextButton.classList.remove(
                "hidden"
            );


            if (isCorrect) {

                createConfetti(
                    window.innerWidth / 2,
                    window.innerHeight / 3,
                    7
                );

            }

        }


        /* =====================================================
           REACTION
           ===================================================== */

        function showReaction(
            isCorrect,
            explanation
        ) {

            const pool =
                isCorrect
                    ? rightReactions
                    : wrongReactions;


            const reaction =
                pool[
                    Math.floor(
                        Math.random() * pool.length
                    )
                ];


            reactionEmoji.textContent =
                reaction.emoji;


            reactionTitle.textContent =
                reaction.title;


            reactionText.innerHTML =
                `${reaction.text}<br><br>
                 <strong>Actually:</strong>
                 ${explanation}`;


            reactionBox.classList.remove(
                "show"
            );


            void reactionBox.offsetWidth;


            reactionBox.classList.add(
                "show"
            );


            if (isCorrect) {

                challengeArea.animate(
                    [
                        {
                            transform: "scale(1)"
                        },

                        {
                            transform: "scale(1.015)"
                        },

                        {
                            transform: "scale(1)"
                        }
                    ],
                    {
                        duration: 350,
                        easing: "ease-out"
                    }
                );

            }

            else {

                challengeArea.animate(
                    [
                        {
                            transform:
                                "translateX(0)"
                        },

                        {
                            transform:
                                "translateX(-5px)"
                        },

                        {
                            transform:
                                "translateX(5px)"
                        },

                        {
                            transform:
                                "translateX(0)"
                        }
                    ],
                    {
                        duration: 300
                    }
                );

            }

        }


        /* =====================================================
           STREAK
           ===================================================== */

        function updateStreak() {

            if (streak >= 5) {

                streakDisplay.textContent =
                    "🔥 BRAIN MOMENTUM";

            }

            else if (streak >= 3) {

                streakDisplay.textContent =
                    `🔥 ${streak} IN A ROW`;

            }

            else {

                streakDisplay.textContent =
                    "";

            }

        }


        /* =====================================================
           NEXT BUTTON
           ===================================================== */

        nextButton.addEventListener(
            "click",
            () => {

                currentChallenge++;


                if (
                    currentChallenge >=
                    TOTAL_CHALLENGES
                ) {

                    finishGame();

                    return;

                }


                loadChallenge();


                window.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });

            }
        );


        /* =====================================================
           FINISH
           ===================================================== */

        function finishGame() {

            progressBar.style.width =
                "100%";


            finalScore.textContent =
                score;


            correctStat.textContent =
                correctAnswers;


            wrongStat.textContent =
                wrongAnswers;


            const accuracy =
                Math.round(
                    (correctAnswers /
                        TOTAL_CHALLENGES) *
                    100
                );


            accuracyStat.textContent =
                `${accuracy}%`;


            let title;

            let message;

            let mascot;


            if (score >= 23) {

                title =
                    "Suspiciously Smart 😳";

                message =
                    "Okay... either you're genuinely brilliant or your brain was running premium hardware.";

                mascot =
                    "🧠";

            }

            else if (score >= 19) {

                title =
                    "Certified Brainiac 🧠";

                message =
                    "That was seriously impressive. Your brain was ON today.";

                mascot =
                    "🤓";

            }

            else if (score >= 15) {

                title =
                    "Professional Thinker 🤔";

                message =
                    "Pretty solid. You survived most of the nonsense.";

                mascot =
                    "😎";

            }

            else if (score >= 10) {

                title =
                    "Certified Overthinker 😭";

                message =
                    "You knew more than you thought. You just... thought too much.";

                mascot =
                    "🫠";

            }

            else {

                title =
                    "Professional Guessologist 💀";

                message =
                    "Your confidence deserves a trophy. Your answers need a little work.";

                mascot =
                    "💀";

            }


            resultTitle.textContent =
                title;


            resultMessage.textContent =
                message;


            resultMascot.textContent =
                mascot;


            const percentage =
                (score / TOTAL_CHALLENGES) *
                360;


            scoreCircle.style.background =
                `conic-gradient(
                    var(--green) ${percentage}deg,
                    var(--green-light) ${percentage}deg
                )`;


            showScreen(resultScreen);


            if (score >= 15) {

                setTimeout(
                    () => {

                        createConfetti(
                            window.innerWidth / 2,
                            100,
                            35
                        );

                    },
                    250
                );

            }

        }


        /* =====================================================
           SHARE
           ===================================================== */

        shareButton.addEventListener(
            "click",
            async () => {

                const shareText =
                    `🧠 I survived the PleyZ Brain Test!\n\n` +
                    `Score: ${score}/${TOTAL_CHALLENGES}\n` +
                    `${resultTitle.textContent}\n\n` +
                    `Can you beat me? 😂`;


                try {

                    if (
                        navigator.share
                    ) {

                        await navigator.share({

                            title:
                                "PleyZ Brain Test",

                            text:
                                shareText

                        });

                    }

                    else {

                        await copyText(
                            shareText
                        );

                        showToast(
                            "Result copied! 📋"
                        );

                    }

                }

                catch (error) {

                    if (
                        error &&
                        error.name ===
                        "AbortError"
                    ) {

                        return;

                    }


                    try {

                        await copyText(
                            shareText
                        );

                        showToast(
                            "Result copied! 📋"
                        );

                    }

                    catch {

                        showToast(
                            "Couldn't share right now."
                        );

                    }

                }

            }
        );


        /* =====================================================
           COPY
           ===================================================== */

        async function copyText(text) {

            if (
                navigator.clipboard &&
                window.isSecureContext
            ) {

                await navigator.clipboard.writeText(
                    text
                );

                return;

            }


            const textarea =
                document.createElement("textarea");


            textarea.value =
                text;


            textarea.style.position =
                "fixed";

            textarea.style.opacity =
                "0";


            document.body.appendChild(
                textarea
            );


            textarea.focus();

            textarea.select();


            document.execCommand(
                "copy"
            );


            textarea.remove();

        }


        /* =====================================================
           PLAY AGAIN
           ===================================================== */

        playButton.addEventListener(
            "click",
            startGame
        );


        againButton.addEventListener(
            "click",
            startGame
        );


        /* =====================================================
           TOAST
           ===================================================== */

        let toastTimer;


        function showToast(message) {

            toast.textContent =
                message;


            toast.classList.add(
                "show"
            );


            clearTimeout(
                toastTimer
            );


            toastTimer =
                setTimeout(
                    () => {

                        toast.classList.remove(
                            "show"
                        );

                    },
                    2400
                );

        }


        /* =====================================================
           CONFETTI
           ===================================================== */

        function createConfetti(
            x,
            y,
            amount
        ) {

            const pieces = [
                "▲",
                "■",
                "●",
                "◆",
                "✦"
            ];


            for (
                let i = 0;
                i < amount;
                i++
            ) {

                const piece =
                    document.createElement(
                        "div"
                    );


                piece.className =
                    "confetti";


                piece.textContent =
                    pieces[
                        Math.floor(
                            Math.random() *
                            pieces.length
                        )
                    ];


                piece.style.left =
                    `${x +
                    (Math.random() * 180 - 90)}px`;


                piece.style.top =
                    `${y +
                    (Math.random() * 40 - 20)}px`;


                piece.style.fontSize =
                    `${8 +
                    Math.random() * 9}px`;


                piece.style.color =
                    [
                        "#38a169",
                        "#ffd84d",
                        "#ff9f43",
                        "#65a9e8",
                        "#ef6b62"
                    ][
                        Math.floor(
                            Math.random() * 5
                        )
                    ];


                piece.style.animationDuration =
                    `${1.2 +
                    Math.random() * 1.2}s`;


                document.body.appendChild(
                    piece
                );


                setTimeout(
                    () => {

                        piece.remove();

                    },
                    2600
                );

            }

        }


        /* =====================================================
           KEYBOARD SUPPORT
           ===================================================== */

        document.addEventListener(
            "keydown",
            (event) => {

                if (
                    event.key === "Enter" &&
                    !nextButton.classList.contains(
                        "hidden"
                    )
                ) {

                    nextButton.click();

                }

            }
        );


        /* =====================================================
           INITIAL STATE
           ===================================================== */

        progressBar.style.width =
            "0%";

    </script>

</body>
</html>